      "seed": 294221366,
      "version": 1,
      "versionNonce": 1935826046,
      "isDeleted": false,
      "updated": 1,
      "locked": false,
      "text": "Quick target reference\n\nmake serve          local development server\nmake lint           HTML/CSS/JS sanity checks\nmake refs           local asset references\nmake validate       netlify.toml + JSON-LD + meta\nmake smoke          temporary HTTP endpoint test\nmake check          main technical quality gate\nmake docs-check     docs/project checklist\nmake final-check    close-out quality gate\nmake deploy         Netlify preview\nmake deploy-prod    Netlify production",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "quick_ref",
      "originalText": "Quick target reference\n\nmake serve          local development server\nmake lint           HTML/CSS/JS sanity checks\nmake refs           local asset references\nmake validate       netlify.toml + JSON-LD + meta\nmake smoke          temporary HTTP endpoint test\nmake check          main technical quality gate\nmake docs-check     docs/project checklist\nmake final-check    close-out quality gate\nmake deploy         Netlify preview\nmake deploy-prod    Netlify production",
      "autoResize": true,
      "lineHeight": 1.25
    },
