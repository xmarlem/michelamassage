    {
      "id": "t_rules",
      "type": "text",
      "x": 670,
      "y": 845,
      "width": 510,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "seed": 510369186,
      "version": 1,
      "versionNonce": 1552017170,
      "isDeleted": false,
      "updated": 1,
      "locked": false,
      "text": "Rules of thumb\n\n1. While editing: use make serve + targeted checks.\n2. Before saying done: always run make final-check.\n3. If checks fail: fix the cause, then rerun.\n4. If docs-relevant changes happened: update docs/ first.\n5. Deploy only after final-check passes.\n6. Production deploy only after preview/manual approval when needed.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rules",
      "originalText": "Rules of thumb\n\n1. While editing: use make serve + targeted checks.\n2. Before saying done: always run make final-check.\n3. If checks fail: fix the cause, then rerun.\n4. If docs-relevant changes happened: update docs/ first.\n5. Deploy only after final-check passes.\n6. Production deploy only after preview/manual approval when needed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
